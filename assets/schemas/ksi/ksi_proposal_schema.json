{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prichindel.com/hesperia/schemas/ksi_proposal_schema.json",
  "title": "KSI LLM Teacher proposal packet",
  "type": "object",
  "required": [
    "proposals"
  ],
  "properties": {
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "confidence",
          "justification"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "add_edge",
              "remove_edge",
              "update_edge_weight",
              "add_concept",
              "update_cd_field"
            ]
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "W_e_proposed": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "W_e_current": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "field": {
            "type": "string"
          },
          "value": {},
          "justification": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "add_edge"
                }
              }
            },
            "then": {
              "required": [
                "source",
                "target",
                "type",
                "W_e_proposed"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "update_edge_weight"
                }
              }
            },
            "then": {
              "required": [
                "source",
                "target",
                "W_e_proposed"
              ]
            }
          }
        ]
      }
    }
  }
}
