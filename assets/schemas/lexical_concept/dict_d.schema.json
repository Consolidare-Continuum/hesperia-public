{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hesperia.local/schemas/dict_d.schema.json",
  "title": "Dict D concept co-occurrence row (CORE-D2 W6, tightened)",
  "type": "object",
  "required": ["concept_id_a", "concept_id_b", "cooc_count", "npmi", "g2", "agreement_with_b", "source_books"],
  "properties": {
    "concept_id_a": {"type": "string", "minLength": 1},
    "concept_id_b": {"type": "string", "minLength": 1},
    "cooc_count": {"type": "integer", "minimum": 1},
    "npmi": {"type": "number", "minimum": -1, "maximum": 1},
    "g2": {"type": "number", "minimum": 0},
    "source_books": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "agreement_with_b": {"type": "string", "enum": ["agrees", "novel"]}
  },
  "additionalProperties": false
}
