{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hesperia.schemas.lexical_concept.dict_b.v0_6_0",
  "title": "Dict B Concept",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "concept_id",
    "preferred_label",
    "definition",
    "family_ids",
    "area_ids",
    "specificity_rank",
    "status",
    "version"
  ],
  "properties": {
    "concept_id": {
      "type": "string",
      "minLength": 1
    },
    "preferred_label": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "family_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^F[0-9]+$"
      }
    },
    "area_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^A([1-9]|10)$"
      }
    },
    "specificity_rank": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "blocked"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "alt_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hidden_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_concept_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusion_concept_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolver_clues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disambiguation_notes": {
      "type": "array",
      "description": "Human-readable disambiguation hints (Ethan PO-05)",
      "items": {
        "type": "string"
      }
    },
    "hex_anchor": {
      "description": "Omit or null until human assigns hex (Ethan Dict B expansion).",
      "type": ["string", "null"]
    },
    "hex_footprint_policy": {
      "type": "string"
    },
    "broader_concept_id": {
      "type": "string"
    },
    "narrower_concept_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

