{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hesperia.schemas.lexical_concept.dict_a.v0_6_0",
  "title": "Dict A Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id",
    "surface_form",
    "normalized_form",
    "match_type",
    "candidate_concept_ids",
    "priority",
    "version"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "minLength": 1
    },
    "surface_form": {
      "type": "string",
      "minLength": 1
    },
    "normalized_form": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "match_type": {
      "type": "string",
      "enum": [
        "exact",
        "phrase",
        "lemma",
        "stem",
        "pattern"
      ]
    },
    "candidate_concept_ids": {
      "type": "array",
      "description": "Empty only when negative_patterns is non-empty (span-blocking entry, Ethan TFP RU negatives).",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "lemma": {
      "type": "string"
    },
    "scope_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hidden_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transcript_variants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negation_sensitive": {
      "type": "boolean"
    }
  }
}

