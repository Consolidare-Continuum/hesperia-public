{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hesperia.schemas.lexical_concept.run_metadata.v0_6_0",
  "title": "DLCR Run Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine_version",
    "mode",
    "deterministic_signature",
    "resource_versions"
  ],
  "properties": {
    "engine_version": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "deterministic_signature": {
      "type": "string"
    },
    "resource_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "dict_a",
        "dict_b",
        "normalization",
        "resolver_rules",
        "hex_topology",
        "aggregation"
      ]
    }
  }
}

