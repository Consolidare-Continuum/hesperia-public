{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hesperia.local/schema/Unit.schema.json",
  "title": "HESPERIA Reading-Scale Unit (R1–R4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "level",
    "parent_id",
    "token_count",
    "top_areas",
    "top_families",
    "SI_metrics",
    "flags"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable structured ID, e.g. R1:sent_1, R2:para_3, R3:CH04, R4:book",
      "pattern": "^R[1-4]:.+"
    },
    "level": {
      "type": "string",
      "enum": ["R1", "R2", "R3", "R4"]
    },
    "parent_id": {
      "type": ["string", "null"]
    },
    "token_count": {
      "type": "integer",
      "minimum": 0
    },
    "top_areas": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/ranked_area" }
    },
    "top_families": {
      "type": "array",
      "minItems": 0,
      "maxItems": 288,
      "items": { "$ref": "#/$defs/ranked_family" }
    },
    "SI_metrics": {
      "$ref": "SI_metrics.schema.json"
    },
    "flags": {
      "$ref": "#/$defs/flags"
    }
  },
  "$defs": {
    "ranked_area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area_id", "coverage", "rank"],
      "properties": {
        "area_id": {
          "type": "string",
          "pattern": "^A\\d+$"
        },
        "coverage": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      }
    },
    "ranked_family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "coverage", "rank"],
      "properties": {
        "family_id": {
          "type": "string",
          "pattern": "^F\\d+$"
        },
        "coverage": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 288
        }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "decision_code"],
      "properties": {
        "band": {
          "type": "string",
          "enum": ["stable", "spiky", "fragmented", "coherent"]
        },
        "decision_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  }
}
