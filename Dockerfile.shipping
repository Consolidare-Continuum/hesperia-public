# HESPERIA API — Multi-stage Docker build. Final image: runtime essentials only.
# Copyright © 2026 igareosh.com. See LEGAL_NOTICE.md.
#
# Build: docker build -f Dockerfile.shipping -t hesperia-api:latest .
# Run:   docker run -p 8000:8000 -e HESPERIA_LICENSE_SKIP=1 hesperia-api:latest
# Save:  docker save hesperia-api:latest -o release/hesperia-api-image.tar

# ------------------------------------------------------------------------------
# Stage 1: Builder — install deps and prepare app tree
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
COPY requirements/ ./requirements/
RUN pip install --no-cache-dir -r requirements/shipping.txt

COPY runtime/   /build/runtime
COPY core/      /build/core
COPY hesperia/  /build/hesperia
COPY assets/    /build/assets
COPY VERSION.yaml /build/VERSION.yaml

# ------------------------------------------------------------------------------
# Stage 2: Final — minimal runtime, no build tools, no source tree
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS final

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /build/runtime   /app/runtime
COPY --from=builder /build/core      /app/core
COPY --from=builder /build/hesperia  /app/hesperia
COPY --from=builder /build/assets    /app/assets
COPY --from=builder /build/VERSION.yaml /app/VERSION.yaml

ENV PYTHONPATH=/app
ENV HESPERIA_ASSETS_ROOT=/app
EXPOSE 8000

CMD ["python", "-m", "uvicorn", "runtime.shipping.api_main:app", "--host", "0.0.0.0", "--port", "8000"]
